<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="E-Commerce Test Suite" parallel="classes" thread-count="3">

    <listeners>
        <listener class-name="utils.TestListener"/>
    </listeners>

    <test name="Product Management Tests">
        <classes>
            <class name="tests.AddNewProductTest"/>
            <class name="tests.EditProductTest"/>
            <class name="tests.DeleteProductTest"/>
        </classes>
    </test>

    <test name="User Registration Tests">
        <classes>
            <class name="tests.UserRegistrationTest"/>
        </classes>
    </test>

    <test name="Shopping Cart Tests">
        <classes>
            <class name="tests.AddToCartTest"/>
            <class name="tests.UpdateCartQuantityTest"/>
            <class name="tests.RemoveFromCartTest"/>
        </classes>
    </test>

    <test name="Checkout Tests">
        <classes>
            <class name="tests.CheckoutTest"/>
        </classes>
    </test>

    <test name="Search and Browse Tests">
        <classes>
            <class name="tests.ProductSearchTest"/>
            <class name="tests.BrowseByCategoryTest"/>
        </classes>
    </test>

</suite>
